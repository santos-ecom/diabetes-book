<link rel='stylesheet' id='ip-countdown-style-css' href='https://atlas-library.com/wp-content/plugins/ip-countdown-by-niro/assets/countdown.css?ver=1.0.0' media='all' />
<style id="ip-countdown-style-inline-css">

                .ip-countdown-sticky {
                    position: -webkit-sticky;
                    position: sticky;
                    top: 0;
                    z-index: 9999;
                    background: rgba(255, 255, 255, 0.95);
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    padding: 12px 15px;
                    box-shadow: 0 2px 20px rgba(0,0,0,0.15);
                    transition: all 0.3s ease;
                    width: 100%;
                    box-sizing: border-box;
                    text-align: center;
                    border-bottom: 1px solid rgba(0,0,0,0.1);
                }

                @media (max-width: 768px) {
                    .ip-countdown-sticky {
                        padding: 10px 12px;
                        top: 0;
                        position: -webkit-sticky;
                        position: sticky;
                    }
                }

                @media (max-width: 480px) {
                    .ip-countdown-sticky {
                        padding: 8px 10px;
                        top: 0px;
                        position: -webkit-sticky;
                        position: sticky;
                        background: rgba(255, 255, 255, 0.98);
                        min-height: auto;
                    }

                    .ip-countdown-sticky .countdown-cards {
                        justify-content: center;
                        align-items: center;
                    }

                    .ip-countdown-sticky .time-card {
                        font-size: 14px !important;
                        padding: 4px 6px !important;
                    }

                    .ip-countdown-sticky .time-label {
                        font-size: 10px !important;
                        margin-top: 1px !important;
                    }
                }

                @media (max-width: 390px) and (-webkit-min-device-pixel-ratio: 2) {
                    .ip-countdown-sticky {
                        padding: 6px 8px;
                        top: env(safe-area-inset-top, 0px);
                        z-index: 99999;
                    }
                }
            
/*# sourceURL=ip-countdown-style-inline-css */
