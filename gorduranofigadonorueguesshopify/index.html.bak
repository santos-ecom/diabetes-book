te-blocks h3:not([class*="-color"]):not([style*="color"]):not([class*="countdown"]):not([class*="time"]), .wp-site-blocks h4:not([class*="-color"]):not([style*="color"]):not([class*="countdown"]):not([class*="time"]), .wp-site-blocks h5:not([class*="-color"]):not([style*="color"]):not([class*="countdown"]):not([class*="time"]), .wp-site-blocks h6:not([class*="-color"]):not([style*="color"]):not([class*="countdown"]):not([class*="time"]), .wp-site-blocks strong:not([class*="-color"]):not([style*="color"]):not([class*="countdown"]):not([class*="time"]), .wp-site-blocks em:not([class*="-color"]):not([style*="color"]):not([class*="countdown"]):not([class*="time"]){color:#ffffff !important;}.ip-countdown-sticky, .ip-countdown-sticky .countdown-label, .ip-countdown-sticky .time-separator, .ip-countdown-sticky .time-label{color:#ffffff !important;}.wp-block-button__link.has-background.wp-element-button, .wp-block-button__link, .wp-element-button{background-color:#4caf50 !important;color:#ffffff !important;border-radius:20px !important;font-family:var(--wp--preset--font-family--system-sans-serif) !important;font-size:var(--wp--preset--font-size--medium) !important;font-weight:bold !important;padding:14px 20px !important;text-decoration:none !important;display:inline-block !important;box-shadow:var(--wp--preset--shadow--natural) !important;text-transform:uppercase !important;}.ip-countdown-sticky .time-card{color:#000000 !important;} .wp-site-blocks p, .wp-site-blocks li, .wp-site-blocks a:not(.wp-block-button__link), .wp-site-blocks span:not(.time-card):not(.time-separator):not(.time-label), .wp-site-blocks h1, .wp-site-blocks h2, .wp-site-blocks h3, .wp-site-blocks h4, .wp-site-blocks h5, .wp-site-blocks h6, .wp-site-blocks strong, .wp-site-blocks em { color: #ffffff !important; }{% endraw %}</style>
    </head>
<body class="wp-singular page-template-wp-custom-template-diabetic-new wp-theme-twentytwentyfour">
    <div class="wp-site-blocks">
        <main class="wp-block-group has-background is-layout-flow wp-block-group-is-layout-flow"
            style="background-color:#177964" id="wp--skip-link--target">
            <div class="ip-countdown-sticky" style="background-color:#e42628;">
                <div class="countdown-label">SISTE TIMER - 70 % RABATT AVSLUTTES SNART</div>
                <span class="countdown-cards">
                    <span class="time-group">
                        <span class="time-card" id="h1">0</span><span class="time-card" id="h2">5</span>
                        <span class="time-label">timer</span>
                    </span>
                    <span class="time-separator">:</span>
                    <span class="time-group">
                        <span class="time-card" id="m1">0</span><span class="time-card" id="m2">9</span>
                        <span class="time-label">min</span>
                    </span>
                    <span class="time-separator">:</span>
                    <span class="time-group">
                        <span class="time-card" id="s1">5</span><span class="time-card" id="s2">5</span>
                        <span class="time-label">sek</span>
                    </span>
                </span>
            </div>
            <script>{% raw %}
                (function () {
                    var total = 5 * 60;
                    function pad(n) { return n < 10 ? '0' + n : '' + n; }
                    function tick() {
                        if (total < 0) total = 0;
                        var h = pad(Math.floor(total / 3600));
                        var m = pad(Math.floor((total % 3600) / 60));
                        var s = pad(total % 60);
                        document.getElementById('h1').textContent = h[0];
                        document.getElementById('h2').textContent = h[1];
                        document.getElementById('m1').textContent = m[0];
                        document.getElementById('m2').textContent = m[1];
                        document.getElementById('s1').textContent = s[0];
                        document.getElementById('s2').textContent = s[1];
                        if (total > 0) total--;
                    }
                    tick();
                    setInterval(tick, 1000);
                })();
            {% endraw %}</script>
            <div class="entry-content wp-block-post-content has-global-padding is-layout-constrained wp-block-post-content-is-layout-constrained">
                <div style="height:40px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-system-sans-serif-font-family has-x-large-font-size">
                    <strong><em>Holder du pusten hver gang legen din snakker om leveren din... men har fortsatt ingen anelse om hva du egentlig bør spise?</em></strong>
                </p>
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size"><strong>Du er ikke den eneste.</strong></p>
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size">Og du gjør ingenting galt.</p>
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size">De fleste som blir diagnostisert med fettlever, får beskjed om: «Gå ned i vekt. Spis sunnere.»</p>
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size">Deretter sendes de hjem uten en reell plan. Ingen måltidseksempler. Ingen steg-for-steg-struktur.</p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <figure class="wp-block-image alignfull size-full"><img fetchpriority="high" decoding="async"
                        width="1080" height="1080" src="{{ 'gordura_IMAGEM1_NO.png' | file_url }}" alt="" class="wp-image-207824"></figure>
                <p class="has-text-align-center has-x-large-font-size" style="margin-right:0;margin-left:0">
                    <strong><strong><strong><strong><strong><strong><strong>Den komplette kokboken for fettlever for nybegynnere + 2 BONUS BØKER</strong></strong></strong></strong></strong></strong></strong>
                </p>
                <p class="has-text-align-center has-x-large-font-size"
                    style="margin-right:var(--wp--preset--spacing--50);margin-left:var(--wp--preset--spacing--50)">⭐⭐⭐⭐⭐
                </p>
                <p class="has-text-align-center has-medium-font-size"><strong>229 kr </strong><mark
                        style="background-color:rgba(0, 0, 0, 0);color:#e42628" class="has-inline-color"><s>689 kr</s>
                    </mark> <strong>Spar 70 %</strong></p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <div class="wp-block-buttons has-custom-font-size has-medium-font-size is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-db7e7d63 wp-block-buttons-is-layout-flex"
                    style="margin-top:var(--wp--preset--spacing--10);margin-bottom:var(--wp--preset--spacing--10)">
                    <div class="wp-block-button has-custom-width wp-block-button__width-100"><a
                            class="wp-block-button__link has-background wp-element-button"
                            href="/no/cart/TODO_VARIANT_ID:1"
                            style="border-radius:20px;background-color:#4caf50;box-shadow:var(--wp--preset--shadow--natural)"><strong>KJØP NÅ</strong></a></div>
                </div>
                <div style="height:30px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-large-font-size"><strong><strong>KJØP 1, FÅ 3</strong></strong></p>
                <p class="has-text-align-center has-medium-font-size">I en begrenset periode får du følgende:
                </p>
                <figure class="wp-block-image alignfull size-large"><img decoding="async" width="1024" height="587"
                        src="{{ 'gordura_IMAGEM2_NO.png' | file_url }}" alt="" class="wp-image-207825"></figure>
                <hr
                    class="wp-block-separator has-text-color has-base-2-color has-alpha-channel-opacity has-base-2-background-color has-background is-style-wide">
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-large-font-size"><strong><em><em>Hvorfor virker dette tilbudet for godt til å være sant?</em></em></strong></p>
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size"><strong>Vi forstår det – tre bestselgende bøker til prisen av én er ikke noe du ser hver dag. </strong></p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size">Her er den enkle sannheten: Én gang i året, rundt denne tiden, arrangerer vi et spesielt arrangement for å takke leserne våre og gjøre våre mest populære samlinger mer tilgjengelige. </p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size">Siden vi styrer alt direkte — fra trykking til frakt — kan vi unngå forhandlerpåslag og tilby hele pakken (normalt 689 kr) for kun 229 kr. </p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-medium-font-size"><strong>Etter at arrangementet er over, går prisene tilbake til det normale.</strong></p>
                <hr
                    class="wp-block-separator has-text-color has-base-2-color has-alpha-channel-opacity has-base-2-background-color has-background is-style-wide">
                <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center has-large-font-size"><strong><em>Fettlever forbedres når…</em></strong></p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center"><strong>…betennelsen avtar og insulinfølsomheten forbedres.</strong></p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <div style="height:0px;width:0px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center"
                    style="margin-right:var(--wp--preset--spacing--60);margin-left:var(--wp--preset--spacing--60)">Dette skjer takket være balanserte, mettende og dokumenterte måltider — ikke gjennom restriksjoner or straff.</p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center"
                    style="margin-right:var(--wp--preset--spacing--60);margin-left:var(--wp--preset--spacing--60)">
                    Det er derfor <strong>Den komplette kokbokpakken for fettlever for nybegynnere</strong> ble opprettet.
                </p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center"
                    style="margin-right:var(--wp--preset--spacing--60);margin-left:var(--wp--preset--spacing--60)">
                    I stedet for én overveldende bok, får du tre nøye utformede guider som fungerer sammen for å gi deg:</p>
                <div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
                <p class="has-text-align-center"
                    style="margin-right:var(--wp--preset--spacing--60);margin-left:var(--wp--preset--spacing--60)">✅
