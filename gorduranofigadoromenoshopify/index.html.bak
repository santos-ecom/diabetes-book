play:inline-flex;align-items:flex-start;flex-wrap:nowrap;gap:0;}.time-group{display:inline-block;text-align:center;margin:0 2px;vertical-align:top;}.time-card{background-color:#ffffff;color:#000000;font-size:22px;font-family:Arial, sans-serif;padding:4px 10px;border-radius:4px;margin:0 1px;border:1px solid #000000;display:inline-block;font-weight:bold;line-height:1;vertical-align:top;}.time-separator{font-size:22px;font-family:Arial, sans-serif;color:#ffffff;font-weight:bold;margin:0 4px;display:inline-block;vertical-align:top;line-height:1;padding-top:4px;}.time-label{display:block;font-size:13px;font-family:Arial, sans-serif;color:#ffffff;font-style:italic;margin-top:4px;line-height:1;text-align:center;}@media (max-width:480px){.time-card{font-size:18px;padding:3px 7px;}.time-separator{font-size:18px;}.time-label{font-size:11px;}}:where(.wp-element-button, .wp-block-button__link){background-color:#4caf50;border-radius:20px;border:0;color:#ffffff;font-family:var(--wp--preset--font-family--system-sans-serif);font-size:var(--wp--preset--font-size--medium);font-weight:500;padding-top:0.6rem;padding-right:1rem;padding-bottom:0.6rem;padding-left:1rem;text-decoration:none;cursor:pointer;}.wp-block-buttons{display:flex;flex-wrap:wrap;box-sizing:border-box;}.wp-block-buttons.is-content-justification-center{justify-content:center;}.wp-block-buttons>.wp-block-button{display:inline-block;margin:0;}.wp-block-button__link{display:inline-block;text-align:center;word-break:break-word;box-shadow:var(--wp--preset--shadow--natural);}.wp-block-buttons>.wp-block-button.wp-block-button__width-75{width:75%;}.wp-block-buttons>.wp-block-button.wp-block-button__width-100{width:100%;}.wp-block-buttons>.wp-block-button.has-custom-width .wp-block-button__link{width:100%;}:where(.wp-block-button__link){border-radius:9999px;padding:calc(.667em + 2px) calc(1.333em + 2px);text-decoration:none;}.wp-block-image{margin-left:auto !important;margin-right:auto !important;text-align:center !important;}.wp-block-image img{width:100%;height:auto;margin:0 auto !important;display:block !important;}.wp-block-image.alignfull img, .wp-block-image.aligncenter img{width:100%;height:auto;margin:0 auto !important;display:block !important;}.alignfull{width:100%;max-width:100%;}.aligncenter{text-align:center;margin-left:auto;margin-right:auto;}.wp-block-separator{border:none;border-top:1px solid;width:100%;}.wp-block-separator.is-style-wide{width:100%;}.wp-block-separator.has-alpha-channel-opacity{opacity:0.4;}.wp-block-spacer{clear:both;}.wp-block-group{box-sizing:border-box;}.wp-block-gallery.has-nested-images{display:flex;flex-wrap:wrap;align-items:normal;}.wp-block-gallery.has-nested-images figure.wp-block-image{box-sizing:border-box;display:flex;flex-direction:column;flex-grow:1;justify-content:center;max-width:100%;width:100%;}.wp-block-gallery.has-nested-images figure.wp-block-image img{display:block;height:auto;width:100%;}.wp-block-gallery-2{gap:var(--wp--preset--spacing--10) 0;}.wp-block-columns{box-sizing:border-box;display:flex;flex-wrap:wrap !important;margin-bottom:1.75em;}@media (min-width:782px){.wp-block-columns{flex-wrap:nowrap !important;}}.wp-block-column{flex-grow:1;min-width:0;overflow-wrap:break-word;word-break:break-word;}@media (max-width:781px){.wp-block-columns>.wp-block-column{flex-basis:100% !important;}}html, body{overflow-x:hidden !important;}@media (max-width:768px){body{--wp--style--root--padding-right:0px !important;--wp--style--root--padding-left:0px !important;max-width:100vw !important;}.wp-site-blocks, main.wp-block-group{padding-left:0 !important;padding-right:0 !important;max-width:100vw !important;overflow-x:hidden !important;}.entry-content.wp-block-post-content{padding-left:16px !important;padding-right:16px !important;box-sizing:border-box !important;max-width:100vw !important;overflow-x:hidden !important;}.wp-block-image.alignfull, figure.wp-block-image.alignfull{margin-left:-16px !important;margin-right:-16px !important;width:calc(100% + 32px) !important;max-width:calc(100% + 32px) !important;box-sizing:border-box !important;}.wp-block-image.alignfull img, figure.wp-block-image.alignfull img, .wp-block-image img{width:100% !important;height:auto !important;display:block !important;max-width:100% !important;}figure.wp-block-image.aligncenter, figure.wp-block-image.alignfull{margin-left:-16px !important;margin-right:-16px !important;width:calc(100% + 32px) !important;}figure.wp-block-image.aligncenter img, figure.wp-block-image.alignfull img{width:100% !important;height:auto !important;}.has-x-large-font-size{font-size:1.4rem !important;}.has-xx-large-font-size{font-size:1.6rem !important;}.has-large-font-size{font-size:1.2rem !important;}p[style*="margin-right:var(--wp--preset--spacing--60)"], p[style*="margin-left:var(--wp--preset--spacing--60)"], p[style*="margin-right:var(--wp--preset--spacing--50)"], p[style*="margin-left:var(--wp--preset--spacing--50)"]{margin-right:0 !important;margin-left:0 !important;}p[style*="padding-right:var(--wp--preset--spacing--40)"], p[style*="padding-left:var(--wp--preset--spacing--40)"], p[style*="padding-right:var(--wp--preset--spacing--50)"], p[style*="padding-left:var(--wp--preset--spacing--50)"]{padding-right:0 !important;padding-left:0 !important;}.wp-block-button.has-custom-width.wp-block-button__width-75{width:100% !important;}.wp-block-button.has-custom-width.wp-block-button__width-100{width:100% !important;}.wp-block-button__link{width:100% !important;font-size:1.1rem !important;padding:14px 20px !important;box-sizing:border-box !important;}.wp-block-columns[style*="flex-wrap:nowrap"]{flex-wrap:wrap !important;}.wp-block-column[style*="flex-basis:30%"], .wp-block-column[style*="flex-basis:50%"]{flex-basis:100% !important;text-align:center;}.wp-block-navigation__container{flex-direction:column;align-items:center;}}@media (min-width:769px){.entry-content.wp-block-post-content{max-width:100% !important;width:100% !important;padding-left:0 !important;pad